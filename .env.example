# ---------------------------------------------------------------------------
# KCD Indonesia 2026 demo -- presenter settings.   cp .env.example .env
# .env is gitignored. Never commit it: the cluster autoscaler secret is built
# from CIVO_API_KEY.
# ---------------------------------------------------------------------------

# Civo API key.  https://dashboard.civo.com/security
CIVO_API_KEY=

# The region that launched the day before the talk. Fallback: SGP1 or LON1.
CIVO_REGION=JKT1

CLUSTER_NAME=kcd-jakarta
CIVO_NODE_SIZE=g4s.kube.medium
CIVO_NODE_COUNT=2
# Leave blank for the newest k3s version Civo offers in the region.
CIVO_K8S_VERSION=

# Autoscaler bounds (worker nodes). The demo pushes past 2 to show a scale-up.
AUTOSCALER_MIN=2
AUTOSCALER_MAX=5

# The repo Argo CD pulls from. Must be public (or add repo creds to Argo).
# `make set-repo` rewrites every repoURL under gitops/ to match this.
GITOPS_REPO_URL=https://github.com/dmajrekar/civo-kcd-indonesia-2026
GITOPS_BRANCH=main
# Argo root path. The standby uses gitops/root-standby (adds the slides deck).
GITOPS_ROOT_PATH=gitops/root

ARGOCD_VERSION=v3.5.6
